<Window x:Class="LameSounds.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LameSounds.App.ViewModels"
        xmlns:models="clr-namespace:LameSounds.Core.Models;assembly=LameSounds.Core"
        mc:Ignorable="d"
        Title="LameSounds - Low Latency Soundboard"
        Height="780" Width="1160"
        MinHeight="640" MinWidth="920"
        Background="{StaticResource BgDarkestBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />    <!-- Main Content with Sidebar -->
            <RowDefinition Height="32" />   <!-- Bottom Compact Status Bar -->
        </Grid.RowDefinitions>

        <!-- Main Desktop Area with Left Navigation Rail -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" /> <!-- Left Windows 11 Navigation Rail -->
                <ColumnDefinition Width="*" />   <!-- Active Page Content -->
            </Grid.ColumnDefinitions>

            <!-- ====================================================================== -->
            <!-- 1. LEFT WINDOWS 11 NAVIGATION RAIL                                     -->
            <!-- ====================================================================== -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- App Brand -->
                        <RowDefinition Height="*" />    <!-- Nav Items -->
                        <RowDefinition Height="Auto" /> <!-- Bottom Status Cards -->
                    </Grid.RowDefinitions>

                    <!-- App Brand Header -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                <TextBlock Text="🔊" FontSize="14" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="LameSounds" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Windows Soundboard" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Windows 11 Navigation Menu Items -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="PAGES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" Margin="12,0,0,8" />

                        <!-- 1. Soundboard Tab -->
                        <RadioButton x:Name="TabSoundboard" Style="{StaticResource WindowsNavButton}" IsChecked="True" GroupName="MainNav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔊" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Soundboard" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Sound Library Tab -->
                        <RadioButton x:Name="TabLibrary" Style="{StaticResource WindowsNavButton}" GroupName="MainNav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sound Library" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. Audio Mixer Tab -->
                        <RadioButton x:Name="TabMixer" Style="{StaticResource WindowsNavButton}" GroupName="MainNav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎚️" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Audio Mixer" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. Mobile Companion Tab -->
                        <RadioButton x:Name="TabCompanion" Style="{StaticResource WindowsNavButton}" GroupName="MainNav" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📱" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Mobile Companion" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar Footer (Network & VB-Cable info) -->
                    <StackPanel Grid.Row="2">
                        <!-- Network Card -->
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Server Online" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding UdpPort, StringFormat='UDP Port: {0}'}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- VB-Cable Pill -->
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Cursor="Hand" MouseDown="VirtualCableBadge_MouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="✓ VB-Cable Ready" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVirtualCableInstalled}" Value="False">
                                                    <Setter Property="Text" Value="⚠️ Install VB-Cable" />
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====================================================================== -->
            <!-- 2. MAIN CONTENT AREA WITH TOP COMMAND BAR                              -->
            <!-- ====================================================================== -->
            <Grid Grid.Column="1" Background="{StaticResource BgDarkestBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" /> <!-- Command Bar -->
                    <RowDefinition Height="*" />  <!-- Active Page Content -->
                </Grid.RowDefinitions>

                <!-- Top Command Bar (Windows 11 Desktop Style) -->
                <Border Grid.Row="0" Background="{StaticResource BgDarkestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Page Title -->
                        <TextBlock x:Name="TxtPageTitle" Grid.Column="0" Text="Soundboard" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                        <!-- Search Box in Center -->
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource PillSearchBox}"
                                 Width="340"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search sounds by title or category" />

                        <!-- Right Actions: + Add Sound, Bulk Import & Stop All -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource WindowsButton}" Margin="0,0,8,0" Click="AddSound_Click" ToolTip="Import an audio file into the soundboard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="+ " FontSize="12" FontWeight="Bold" Margin="0,0,4,0" />
                                    <TextBlock Text="Add Sound" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource WindowsButton}" Margin="0,0,8,0" Click="BulkImport_Click" ToolTip="Select multiple audio files to import automatically using their file names">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁 " FontSize="11" Margin="0,0,4,0" />
                                    <TextBlock Text="Bulk Import" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerButton}" Click="StopAll_Click" ToolTip="Immediately silence all playing sounds">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏹ " FontSize="11" Margin="0,0,4,0" />
                                    <TextBlock Text="Stop All" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================================================================== -->
                <!-- PAGE 1: SOUNDBOARD (Responsive Desktop Cards Grid)                -->
                <!-- ================================================================== -->
                <Grid x:Name="PageSoundboard" Grid.Row="1" Margin="28,16,28,16" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Category Filter Bar -->
                        <RowDefinition Height="*" />    <!-- Responsive Grid of Sound Cards -->
                    </Grid.RowDefinitions>

                    <!-- Category Filter Chips -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="All" Style="{StaticResource CategoryFilterPill}" IsChecked="True" Tag="ALL" Checked="CategoryFilter_Checked" Margin="0,0,6,0" />
                        <RadioButton Content="CS2 Calls" Style="{StaticResource CategoryFilterPill}" Tag="CS2" Checked="CategoryFilter_Checked" Margin="0,0,6,0" />
                        <RadioButton Content="Memes" Style="{StaticResource CategoryFilterPill}" Tag="MEMES" Checked="CategoryFilter_Checked" Margin="0,0,6,0" />
                        <RadioButton Content="Reactions" Style="{StaticResource CategoryFilterPill}" Tag="REACTIONS" Checked="CategoryFilter_Checked" Margin="0,0,6,0" />
                        <RadioButton Content="Custom" Style="{StaticResource CategoryFilterPill}" Tag="CUSTOM" Checked="CategoryFilter_Checked" />
                    </StackPanel>

                    <!-- Empty State when no sounds added yet -->
                    <Border Grid.Row="1"
                            Style="{StaticResource WindowsCard}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="40,32"
                            MaxWidth="480"
                            Visibility="{Binding FilteredSounds.Count, Converter={StaticResource EmptyCountToVisConv}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28" Background="#1C1C1C" Margin="0,0,0,16" HorizontalAlignment="Center">
                                <TextBlock Text="🎵" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No sounds in your soundboard yet" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Import audio files (.mp3, .wav, .ogg, .flac) or drag &amp; drop them directly into this window to start triggering sounds."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,20" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource WindowsPrimaryButton}" Click="AddSound_Click" Padding="16,8" Margin="0,0,8,0">
                                    <TextBlock Text="+ Add Single Sound" FontSize="12" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource WindowsButton}" Click="BulkImport_Click" Padding="16,8">
                                    <TextBlock Text="📁 Bulk Import Audio Files" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sound Cards Container (Responsive WrapPanel) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding FilteredSounds.Count, Converter={StaticResource InverseEmptyCountToVisConv}}">
                        <ItemsControl ItemsSource="{Binding FilteredSounds}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Clean Windows 11 Desktop Sound Card (~215px × 110px) -->
                                    <Border Width="215" Height="110"
                                            Margin="0,0,12,12"
                                            Background="{StaticResource BgCardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Cursor="Hand"
                                            MouseDown="SoundCard_PlayClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <!-- Context Menu -->
                                        <Border.ContextMenu>
                                            <ContextMenu Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}">
                                                <MenuItem Header="Play Sound" Click="PlayContext_Click" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <MenuItem Header="Stop Sound" Click="StopContext_Click" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <Separator Background="{StaticResource BorderBrush}" />
                                                <MenuItem Header="Edit Sound..." Click="EditContext_Click" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <MenuItem Header="Delete Sound" Click="DeleteContext_Click" Foreground="{StaticResource DangerBrush}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Accent Color/Gradient Strip on Left -->
                                            <Border Grid.Column="0"
                                                    Background="{Binding Converter={StaticResource SoundClipToBrushConv}}"
                                                    CornerRadius="3,0,0,3" />

                                            <Grid Grid.Column="1" Margin="12,10,12,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Title, Image Thumbnail, and Category -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="38" />

                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            <TextBlock Text=" • " FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                                            <TextBlock Text="{Binding DurationSeconds, StringFormat='{}{0:0.0}s'}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Optional Image Icon -->
                                                    <Border Grid.Column="1"
                                                            Width="26" Height="26"
                                                            CornerRadius="4"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Top"
                                                            Visibility="{Binding ImagePath, Converter={StaticResource NullOrEmptyToVisConv}}">
                                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                </Grid>

                                                <!-- Card Bottom: Quick Action Buttons -->
                                                <Grid Grid.Row="1">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource WindowsButton}"
                                                                Padding="8,3"
                                                                Margin="0,0,4,0"
                                                                Click="PlayButton_Click"
                                                                Tag="{Binding}"
                                                                ToolTip="Play Sound">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="▶ " FontSize="9" VerticalAlignment="Center" />
                                                                <TextBlock Text="Play" FontSize="10" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>

                                                        <Button Style="{StaticResource WindowsButton}"
                                                                Padding="6,3"
                                                                Click="StopButton_Click"
                                                                Tag="{Binding}"
                                                                ToolTip="Stop Sound">
                                                            <TextBlock Text="⏹" FontSize="9" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ================================================================== -->
                <!-- PAGE 2: SOUND LIBRARY (Table / Detailed Management View)           -->
                <!-- ================================================================== -->
                <Grid x:Name="PageLibrary" Grid.Row="1" Margin="28,16,28,16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Summary & Add Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilteredSounds.Count, StringFormat='{}{0} Audio Clips Available'}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource WindowsButton}" Margin="0,0,8,0" Click="ImportFromPhone_Click"
                                    ToolTip="Import all sounds from your connected Android phone">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📲 " FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Import from Phone" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource WindowsPrimaryButton}" Click="AddSound_Click">
                                <TextBlock Text="+ Import Audio File" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Library Table View -->
                    <Border Grid.Row="1" Style="{StaticResource WindowsCard}" Padding="0">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                                        Visibility="{Binding FilteredSounds.Count, Converter={StaticResource EmptyCountToVisConv}}">
                                <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Your Sound Library is Empty" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Import MP3, WAV, or OGG audio files, or load your sound collection from your phone." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource WindowsButton}" Margin="0,0,8,0" Click="ImportFromPhone_Click" Padding="14,8">
                                        <TextBlock Text="📲 Import from Phone" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource WindowsPrimaryButton}" Click="AddSound_Click" Padding="16,8">
                                        <TextBlock Text="+ Import Audio File" FontSize="12" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding FilteredSounds.Count, Converter={StaticResource InverseEmptyCountToVisConv}}">
                                <ItemsControl ItemsSource="{Binding FilteredSounds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" /> <!-- Play button -->
                                                        <ColumnDefinition Width="*" />    <!-- Title & File -->
                                                        <ColumnDefinition Width="130" />  <!-- Category -->
                                                        <ColumnDefinition Width="90" />   <!-- Duration -->
                                                        <ColumnDefinition Width="Auto" /> <!-- Actions (Edit & Delete) -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Play Preview -->
                                                    <Button Grid.Column="0" Style="{StaticResource WindowsButton}" Width="32" Height="32" Padding="0" Margin="0,0,14,0" Click="PlayButton_Click" Tag="{Binding}">
                                                        <TextBlock Text="▶" FontSize="11" />
                                                    </Button>

                                                    <!-- Title, Image, & Path -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                                        <Border Width="28" Height="28" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding ImagePath, Converter={StaticResource NullOrEmptyToVisConv}}">
                                                            <Image Source="{Binding ImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Category -->
                                                    <Border Grid.Column="2" Background="#1F1F1F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>

                                                    <!-- Duration -->
                                                    <TextBlock Grid.Column="3" Text="{Binding DurationSeconds, StringFormat='{}{0:0.0}s'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                                    <!-- Actions: Edit & Delete -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource WindowsButton}" Padding="10,5" Margin="0,0,6,0" Click="EditButton_Click" Tag="{Binding}" ToolTip="Edit sound details">
                                                            <TextBlock Text="Edit" FontSize="11" />
                                                        </Button>
                                                        <Button Style="{StaticResource DangerButton}" Padding="10,5" Click="DeleteButton_Click" Tag="{Binding}" ToolTip="Delete sound">
                                                            <TextBlock Text="Delete" FontSize="11" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================================================================== -->
                <!-- PAGE 3: AUDIO MIXER (Windows 11 Device Routing & Sliders)         -->
                <!-- ================================================================== -->
                <ScrollViewer x:Name="PageMixer" Grid.Row="1" Margin="28,16,28,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <!-- Card 1: Monitoring (Headphones) -->
                        <Border Style="{StaticResource WindowsCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🎧 Monitor Device (Headphones)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding MonitorVolume, StringFormat='Volume: {0:P0}'}" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Select your headphones or speakers to hear sounds locally." FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,10" />

                                <ComboBox ItemsSource="{Binding PlaybackDevices}"
                                          SelectedItem="{Binding SelectedMonitorDevice}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,6">
                                    <ProgressBar Value="{Binding MonitorPeak}" Maximum="100" Height="4" Background="#1C1C1C" BorderThickness="0" Foreground="{StaticResource SuccessBrush}" />
                                </Grid>

                                <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1" Value="{Binding MonitorVolume}" SmallChange="0.05" LargeChange="0.1" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Broadcast (Virtual Audio Cable) -->
                        <Border Style="{StaticResource WindowsCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🎙️ Broadcast Device (Virtual Cable / In-Game Mic)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding BroadcastVolume, StringFormat='Volume: {0:P0}'}" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Routes audio into games (CS2, Valorant, Discord). Set this to CABLE Input." FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,10" />

                                <ComboBox ItemsSource="{Binding PlaybackDevices}"
                                          SelectedItem="{Binding SelectedBroadcastDevice}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,6">
                                    <ProgressBar Value="{Binding BroadcastPeak}" Maximum="100" Height="4" Background="#1C1C1C" BorderThickness="0" Foreground="{StaticResource SuccessBrush}" />
                                </Grid>

                                <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1" Value="{Binding BroadcastVolume}" SmallChange="0.05" LargeChange="0.1" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Microphone Passthrough -->
                        <Border Style="{StaticResource WindowsCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="🎤 Microphone Passthrough" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding MicVolume, StringFormat='Mic Volume: {0:P0}'}" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="Mixes your physical voice into the Virtual Cable so teammates can hear both your voice and sound effects." FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,10" />

                                <ComboBox ItemsSource="{Binding CaptureDevices}"
                                          SelectedItem="{Binding SelectedMicDevice}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}"
                                          Margin="0,0,0,12" />

                                <CheckBox IsChecked="{Binding MicPassthroughEnabled}" Margin="0,0,0,10">
                                    <TextBlock Text="Enable Microphone Passthrough into Broadcast Cable" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </CheckBox>

                                <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="1" Value="{Binding MicVolume}" SmallChange="0.05" LargeChange="0.1" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Auto-Ducking -->
                        <Border Style="{StaticResource WindowsCard}">
                            <StackPanel>
                                <TextBlock Text="⚡ Auto-Ducking" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Automatically lowers the soundboard volume whenever you speak into your microphone, keeping your callouts clear." FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,10" />

                                <CheckBox IsChecked="{Binding AutoDuckingEnabled}">
                                    <TextBlock Text="Enable Automatic Audio Ducking on Voice Activity" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================================================== -->
                <!-- PAGE 4: MOBILE COMPANION (QR Code & Networking)                    -->
                <!-- ================================================================== -->
                <ScrollViewer x:Name="PageCompanion" Grid.Row="1" Margin="28,16,28,16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <!-- Card 1: Wireless Pairing -->
                        <Border Style="{StaticResource WindowsCard}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- QR Code Box -->
                                <Border Grid.Column="0" Width="130" Height="130" Background="#FFFFFF" CornerRadius="6" Padding="6" HorizontalAlignment="Left">
                                    <Image Source="{Binding QrCodeImage}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock Text="Connect Android Companion" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Scan this QR code with the LameSounds mobile app or enter the connection details below." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#1C1C1C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding IpAddress, StringFormat='Host IP: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                        <Border Background="#1C1C1C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding UdpPort, StringFormat='UDP: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Background="#1C1C1C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding HttpPort, StringFormat='HTTP: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <Button Style="{StaticResource WindowsButton}" HorizontalAlignment="Left" Click="TestTrigger_Click">
                                        <TextBlock Text="⚡ Send Test UDP Trigger" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Live Activity Logs -->
                        <Border Style="{StaticResource WindowsCard}">
                            <StackPanel>
                                <TextBlock Text="Incoming Trigger Logs" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Live real-time feed of network packets received from your phone or hotkeys." FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,10" />

                                <Border Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Height="220" Padding="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ActivityLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ====================================================================== -->
        <!-- 3. BOTTOM COMPACT STATUS BAR                                           -->
        <!-- ====================================================================== -->
        <Border Grid.Row="1" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Status Activity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Status: " FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                </StackPanel>

                <!-- Center: Ports info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UdpPort, StringFormat='UDP {0}'}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="•" FontSize="10" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding HttpPort, StringFormat='HTTP {0}'}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                </StackPanel>

                <!-- Right: Monitoring / Broadcast summary -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MonitorVolume, StringFormat='🎧 {0:P0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding BroadcastVolume, StringFormat='🎙️ {0:P0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
