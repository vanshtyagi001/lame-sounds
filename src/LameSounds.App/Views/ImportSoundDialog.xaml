<Window x:Class="LameSounds.App.Views.ImportSoundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:LameSounds.App.Converters"
        mc:Ignorable="d"
        Title="Import Audio Clip"
        Height="700" Width="880"
        MinHeight="580" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDarkestBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Gradient Preset Button Style -->
        <Style x:Key="GradientPresetButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#60CDFF" BlurRadius="6" ShadowDepth="0" Opacity="0.3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Circle Preset Button Style -->
        <Style x:Key="SolidPresetButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFF" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header Bar -->
            <RowDefinition Height="*" />    <!-- Responsive 2-Column Content -->
            <RowDefinition Height="Auto" /> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. HEADER BAR                                                  -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeader" Text="Import Audio Clip" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="TxtSubheader" Text="Customize audio title, category, accent gradients, and optional artwork icon."
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Audio File Badge -->
            <Border x:Name="BadgeFileDetails" Grid.Column="1" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎵" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="TxtBadgeFileName" Text="audio.mp3" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtBadgeFileSize" Text="0 KB" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- 2. MAIN RESPONSIVE 2-COLUMN LAYOUT                             -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" /> <!-- Form Fields -->
                <ColumnDefinition Width="18" />              <!-- Spacer -->
                <ColumnDefinition Width="310" />             <!-- Live Preview Sticky Panel -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: SCROLLABLE FORM -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>

                    <!-- CARD A: SOUND INFORMATION -->
                    <Border Style="{StaticResource WindowsCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SOUND INFORMATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,12" />

                            <!-- Title -->
                            <TextBlock Text="Sound Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="TxtTitle" Style="{StaticResource PillSearchBox}" TextChanged="Field_Changed" Margin="0,0,0,14" />

                            <!-- Category -->
                            <TextBlock Text="Category" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="CmbCategory" Style="{StaticResource ModernComboBox}" SelectionChanged="Field_Changed">
                                <ComboBoxItem Content="Custom" IsSelected="True" />
                                <ComboBoxItem Content="CS2 Calls" />
                                <ComboBoxItem Content="Memes" />
                                <ComboBoxItem Content="Reactions" />
                                <ComboBoxItem Content="SFX" />
                                <ComboBoxItem Content="Music" />
                                <ComboBoxItem Content="General" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- CARD B: PREDEFINED GRADIENTS & ACCENT STYLING -->
                    <Border Style="{StaticResource WindowsCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PREDEFINED GRADIENTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Click any preset to apply" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Predefined Gradients Gallery -->
                            <WrapPanel x:Name="PnlPredefinedGradients" Margin="0,0,0,12">
                                <!-- 1. Windows Aurora -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#60CDFF|#8B5CF6|Windows Aurora" ToolTip="Windows Aurora (#60CDFF → #8B5CF6)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#60CDFF" Offset="0" />
                                            <GradientStop Color="#8B5CF6" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Aurora" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- 2. Cyberpunk Cyan -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#00F2FE|#4FACFE|Cyberpunk Cyan" ToolTip="Cyberpunk Cyan (#00F2FE → #4FACFE)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00F2FE" Offset="0" />
                                            <GradientStop Color="#4FACFE" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Cyberpunk" FontSize="11" FontWeight="SemiBold" Foreground="#001529" />
                                </Button>

                                <!-- 3. Sunset Glow -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#FA709A|#FEE140|Sunset Glow" ToolTip="Sunset Glow (#FA709A → #FEE140)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FA709A" Offset="0" />
                                            <GradientStop Color="#FEE140" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Sunset" FontSize="11" FontWeight="SemiBold" Foreground="#3A0815" />
                                </Button>

                                <!-- 4. Neon Violet -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#7F00FF|#E100FF|Neon Violet" ToolTip="Neon Violet (#7F00FF → #E100FF)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7F00FF" Offset="0" />
                                            <GradientStop Color="#E100FF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Neon Violet" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- 5. Aurora Emerald -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#0BA360|#3CBA92|Aurora Emerald" ToolTip="Aurora Emerald (#0BA360 → #3CBA92)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0BA360" Offset="0" />
                                            <GradientStop Color="#3CBA92" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Emerald" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- 6. Electric Coral -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#FF0844|#FFB199|Electric Coral" ToolTip="Electric Coral (#FF0844 → #FFB199)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF0844" Offset="0" />
                                            <GradientStop Color="#FFB199" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Coral" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- 7. Cosmic Indigo -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#6366F1|#A855F7|Cosmic Indigo" ToolTip="Cosmic Indigo (#6366F1 → #A855F7)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6366F1" Offset="0" />
                                            <GradientStop Color="#A855F7" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Cosmic" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- 8. Midnight Aqua -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#1A2980|#26D0CE|Midnight Aqua" ToolTip="Midnight Aqua (#1A2980 → #26D0CE)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1A2980" Offset="0" />
                                            <GradientStop Color="#26D0CE" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Midnight" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- 9. Blazing Flame -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#F83600|#FE8C00|Blazing Flame" ToolTip="Blazing Flame (#F83600 → #FE8C00)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F83600" Offset="0" />
                                            <GradientStop Color="#FE8C00" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Flame" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- 10. Mint Frost -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#10B981|#06B6D4|Mint Frost" ToolTip="Mint Frost (#10B981 → #06B6D4)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10B981" Offset="0" />
                                            <GradientStop Color="#06B6D4" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Mint Frost" FontSize="11" FontWeight="SemiBold" Foreground="#002B1D" />
                                </Button>

                                <!-- 11. Golden Amber -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#F59E0B|#EF4444|Golden Amber" ToolTip="Golden Amber (#F59E0B → #EF4444)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F59E0B" Offset="0" />
                                            <GradientStop Color="#EF4444" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Amber" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>

                                <!-- 12. Dark Titanium -->
                                <Button Style="{StaticResource GradientPresetButton}" Click="ApplyPredefinedGradient_Click" Tag="#64748B|#1E293B|Dark Titanium" ToolTip="Dark Titanium (#64748B → #1E293B)">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#64748B" Offset="0" />
                                            <GradientStop Color="#1E293B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <TextBlock Text="Titanium" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Button>
                            </WrapPanel>

                            <!-- Solid Accent Presets -->
                            <TextBlock Text="SOLID ACCENT COLORS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" Margin="0,4,0,8" />
                            <WrapPanel Margin="0,0,0,12">
                                <Button Style="{StaticResource SolidPresetButton}" Background="#60CDFF" Tag="#60CDFF" ToolTip="Windows Cyan" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#EF4444" Tag="#EF4444" ToolTip="Crimson Red" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#F59E0B" Tag="#F59E0B" ToolTip="Amber Yellow" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#10B981" Tag="#10B981" ToolTip="Emerald Green" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#06B6D4" Tag="#06B6D4" ToolTip="Vibrant Teal" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#6366F1" Tag="#6366F1" ToolTip="Royal Indigo" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#8B5CF6" Tag="#8B5CF6" ToolTip="Deep Purple" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#EC4899" Tag="#EC4899" ToolTip="Hot Pink" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#94A3B8" Tag="#94A3B8" ToolTip="Slate Grey" Click="ColorPreset_Click" />
                                <Button Style="{StaticResource SolidPresetButton}" Background="#F8FAFC" Tag="#F8FAFC" ToolTip="Pure Frost" Click="ColorPreset_Click" />
                            </WrapPanel>

                            <!-- Custom Color Inputs & Gradient Toggle -->
                            <Border Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Custom Hex Codes" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <CheckBox x:Name="ChkGradient" Grid.Column="1" Content="Enable Gradient" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                                  Checked="GradientToggle_Changed" Unchecked="GradientToggle_Changed" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Primary / Start Color -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Start Color:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border x:Name="PnlColorPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#60CDFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                        <TextBox x:Name="TxtColorHex" Grid.Column="3" Style="{StaticResource PillSearchBox}" Text="#60CDFF" TextChanged="ColorHex_Changed" Height="30" FontSize="11" />
                                    </Grid>

                                    <!-- Secondary / End Color (Shown when Gradient enabled) -->
                                    <Grid x:Name="PnlGradientDetails" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="End Color:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border x:Name="PnlGradientPreview" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#8B5CF6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                        <TextBox x:Name="TxtGradientHex" Grid.Column="3" Style="{StaticResource PillSearchBox}" Text="#8B5CF6" TextChanged="GradientHex_Changed" Height="30" FontSize="11" />
                                        <Button Grid.Column="5" Style="{StaticResource WindowsButton}" Width="28" Height="28" Padding="0" Click="SwapColors_Click" ToolTip="Swap start and end colors">
                                            <TextBlock Text="⇄" FontSize="13" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- CARD C: SOUND ARTWORK / ICON -->
                    <Border Style="{StaticResource WindowsCard}">
                        <StackPanel>
                            <TextBlock Text="ARTWORK / ICON (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail Box -->
                                <Border Grid.Column="0" Width="52" Height="52" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,14,0">
                                    <Grid>
                                        <TextBlock x:Name="TxtNoImage" Text="🖼️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image x:Name="ImgPreview" Stretch="UniformToFill" Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Style="{StaticResource WindowsButton}" Padding="12,6" Margin="0,0,8,0" Click="BrowseImage_Click">
                                            <TextBlock Text="Choose Image..." FontSize="11" />
                                        </Button>
                                        <Button x:Name="BtnRemoveImage" Style="{StaticResource WindowsButton}" Padding="10,6" Visibility="Collapsed" Click="RemoveImage_Click">
                                            <TextBlock Text="Remove" FontSize="11" Foreground="{StaticResource DangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Recommended PNG, JPG, or WEBP. Appears on sound card top right." FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: LIVE SOUNDBOARD PREVIEW & METADATA -->
            <Border Grid.Column="2" Style="{StaticResource WindowsCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="Auto" /> <!-- Live Sound Card Mockup -->
                        <RowDefinition Height="Auto" /> <!-- Audio Test Play Bar -->
                        <RowDefinition Height="*" />    <!-- Metadata Inspector -->
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="LIVE SOUNDBOARD PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Real-time look on your soundboard tile" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="12,2,0,0" />
                    </StackPanel>

                    <!-- Live Sound Card Mockup (~215px × 110px exact dimensions) -->
                    <Border Grid.Row="1"
                            Width="215" Height="110"
                            HorizontalAlignment="Center"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Accent Strip (Color / Gradient) -->
                            <Border x:Name="CardAccentStrip" Grid.Column="0" Background="#60CDFF" CornerRadius="3,0,0,3" />

                            <Grid Grid.Column="1" Margin="12,10,12,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Title, Category, and Mini Thumbnail -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="PreviewTitle" Text="Sound Name" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="PreviewCategory" Text="Custom • 0.0s" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <!-- Mini Image Thumbnail in Preview -->
                                    <Border x:Name="PreviewThumbnailBorder" Grid.Column="1" Width="26" Height="26" CornerRadius="4" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Top">
                                        <Image x:Name="PreviewThumbnailImg" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>

                                <!-- Play/Stop icons at bottom right -->
                                <Grid Grid.Row="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Width="20" Height="20" Background="#1E1E1E" CornerRadius="3" Margin="0,0,4,0">
                                            <TextBlock Text="▶" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                        <Border Width="20" Height="20" Background="#1E1E1E" CornerRadius="3">
                                            <TextBlock Text="⏹" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Interactive Audio Test Player -->
                    <Border Grid.Row="2" Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Audio Playback Test" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtPlaybackStatus" Text="Ready to preview" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                            <Button x:Name="BtnTestAudio" Grid.Column="1" Style="{StaticResource WindowsButton}" Padding="10,5" Click="TestAudio_Click">
                                <TextBlock x:Name="TxtTestAudioLabel" Text="▶ Play" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- File Details & Metadata Card -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                        <Border Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="CLIP METADATA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Source File:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtMetaSource" Text="Direct Import" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="File Size:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtMetaSize" Text="Unknown" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Audio Format:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtMetaFormat" Text="MP3 / WAV" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Accent Mode:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="TxtMetaAccent" Text="Solid Accent" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- 3. ACTION FOOTER                                               -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource WindowsButton}" Padding="18,8" Margin="0,0,10,0" Click="Cancel_Click">
                    <TextBlock Text="Cancel" FontSize="12" />
                </Button>
                <Button Style="{StaticResource WindowsPrimaryButton}" Padding="22,8" Click="Save_Click">
                    <TextBlock x:Name="TxtSaveBtn" Text="Import Sound" FontSize="12" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
